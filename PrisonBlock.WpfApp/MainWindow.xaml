<Window x:Class="PrisonBlock.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Prison Block 13"
        Width="1000" Height="550"
        MinWidth="600" MinHeight="400">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Vangid"
                  Grid.Column="0"
                  Margin="0,0,5,0">

            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Nimi" Grid.Row="0"/>

                <TextBox x:Name="NameTextBox"
                         Grid.Row="1"
                         MaxLength="20"
                         Margin="0,0,0,10"/>

                <Label Content="Tüüp" Grid.Row="2"/>

                <ComboBox x:Name="TypeBox"
                          SelectedIndex="0"
                          Grid.Row="3"
                          Margin="0,0,0,10">
                    <ComboBoxItem Content="Rookie"/>
                    <ComboBoxItem Content="Philosopher"/>
                    <ComboBoxItem Content="Artist"/>
                    <ComboBoxItem Content="ChessMaster"/>
                </ComboBox>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Lisa vang"
                            Grid.Row="0"
                            Height="35"
                            Margin="0,0,0,10"
                            Click="Add_Click"/>

                    <ListBox x:Name="PrisonerList"
                             Grid.Row="1"
                             ItemsSource="{Binding Prisoners}"
                             SelectedItem="{Binding SelectedPrisoner, Mode=TwoWay}"
                             DisplayMemberPath="Name"/>
                </Grid>
            </Grid>
        </GroupBox>
        <StackPanel/>
        <GroupBox Grid.Column="1" Header="Valitud vang">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DetailsText" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock Text="Energia" Margin="0,12,0,2"/>
                    <ProgressBar x:Name="EnergyBar" Minimum="0" Maximum="100" Height="18"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,15,0,10">
                    <Button Content="Crazy Action" Click="Crazy_Click" Padding="10,6" Margin="0,0,6,6"/>
                    <Button Content="Work" Click="Work_Click" Padding="10,6" Margin="0,0,6,6"/>
                    <Button Content="Study" Click="Study_Click" Padding="10,6" Margin="0,0,6,6"/>
                    <Button Content="Play Chess" Click="Chess_Click" Padding="10,6" Margin="0,0,6,6"/>
                    <Button Content="Remove" Click="Remove_Click" Padding="10,6" Margin="0,0,6,6"/>
                </WrapPanel>
                <Expander Grid.Row="2" Header="Action log" IsExpanded="True">
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="260"/>
                </Expander>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
