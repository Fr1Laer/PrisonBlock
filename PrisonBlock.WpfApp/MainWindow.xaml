<Window x:Class="PrisonBlock.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Prison Block 13"
        Width="1000" Height="550"
        MinWidth="600" MinHeight="400">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: Prisoners and adding a new prisoner -->
        <GroupBox Header="Vangid"
                  Grid.Column="0"
                  Margin="0,0,5,0">

            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Nimi"
                       Grid.Row="0"/>

                <TextBox Grid.Row="1"
                         MaxLength="20"
                         Margin="0,0,0,10"
                         Text="{Binding NewName,
                             UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Tüüp"
                       Grid.Row="2"/>

                <ComboBox Grid.Row="3"
                          Margin="0,0,0,10"
                          ItemsSource="{Binding RepositoryTypes}"
                          SelectedItem="{Binding SelectedRepositoryType,
                              Mode=TwoWay}"/>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Lisa vang"
                            Grid.Row="0"
                            Height="35"
                            Margin="0,0,0,10"
                            Command="{Binding AddCommand}"/>

                    <TextBox Grid.Row="1"
                             Margin="0,0,0,10"
                             ToolTip="Otsi vange nime järgi"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredPrisoners}"
                             SelectedItem="{Binding SelectedPrisoner, Mode=TwoWay}"
                             DisplayMemberPath="Name"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- RIGHT SIDE: Selected prisoner, actions, LINQ results and log -->
        <GroupBox Grid.Column="1"
                  Header="Valitud vang">

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selected prisoner details -->
                <StackPanel Grid.Row="0">
                    <TextBlock FontSize="16"
                               TextWrapping="Wrap"
                               Text="{Binding SelectedDetails}"/>

                    <TextBlock Text="Energia"
                               Margin="0,12,0,2"/>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="18"
                                 Value="{Binding SelectedEnergy, Mode=OneWay}"/>
                </StackPanel>

                <!-- Prisoner actions -->
                <WrapPanel Grid.Row="1"
                           Margin="0,15,0,10">

                    <Button Content="Crazy Action"
                            Command="{Binding CrazyActionCommand}"
                            Padding="10,6"
                            Margin="0,0,6,6"/>

                    <Button Content="Work"
                            Command="{Binding WorkCommand}"
                            Padding="10,6"
                            Margin="0,0,6,6"/>

                    <Button Content="Study"
                            Command="{Binding StudyCommand}"
                            Padding="10,6"
                            Margin="0,0,6,6"/>

                    <Button Content="Play Chess"
                            Command="{Binding ChessCommand}"
                            Padding="10,6"
                            Margin="0,0,6,6"/>

                    <Button Content="Remove"
                            Command="{Binding RemoveCommand}"
                            Padding="10,6"
                            Margin="0,0,6,6"/>
                </WrapPanel>

                <!-- LINQ results and action log -->
                <TabControl Grid.Row="2">

                    <TabItem Header="Sorteeritud">
                        <ListBox ItemsSource="{Binding SortedPrisoners}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text=" -  energia: "/>
                                        <Run Text="{Binding Energy, Mode=OneWay}"/>
                                        <Run Text="/100"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <TabItem Header="Tüüpide kokkuvõte">
                        <ListBox ItemsSource="{Binding Summary}"/>
                    </TabItem>

                    <TabItem Header="Action log">
                        <ListBox ItemsSource="{Binding Log}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </TabItem>

                </TabControl>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
