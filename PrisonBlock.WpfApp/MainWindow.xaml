<Window x:Class="PrisonBlock.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Prison Block 13"
        Width="1000" Height="800"
        MinWidth="600" MinHeight="400">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: Prisoners and adding a new prisoner -->
        <GroupBox Header="Vangid"
                  Grid.Column="0"
                  Margin="0,0,5,0">

            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Nimi"
                       Grid.Row="0"/>

                <TextBox Grid.Row="1"
                         MaxLength="20"
                         Margin="0,0,0,10"
                         Text="{Binding NewName,
                             UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Tüüp"
                       Grid.Row="2"/>

                <ComboBox Grid.Row="3"
                          Margin="0,0,0,10"
                          ItemsSource="{Binding RepositoryTypes}"
                          SelectedItem="{Binding SelectedRepositoryType,
                              Mode=TwoWay}"/>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Lisa vang"
                            Grid.Row="0"
                            Height="35"
                            Margin="0,0,0,10"
                            Command="{Binding AddCommand}"/>

                    <TextBox Grid.Row="1"
                             Margin="0,0,0,10"
                             ToolTip="Otsi vange nime järgi"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredPrisoners}"
                             SelectedItem="{Binding SelectedPrisoner, Mode=TwoWay}"
                             DisplayMemberPath="Name"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- RIGHT SIDE: Selected prisoner, actions, LINQ results and log -->
        <GroupBox Grid.Column="1"
                  Header="Prison Block 13">

            <TabControl Margin="5">

                <TabItem Header="Valitud vang">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                <!-- Selected prisoner details -->
                        <StackPanel Grid.Row="0">
                            <TextBlock FontSize="16"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedDetails}"/>

                            <TextBlock Text="Energia"
                                       Margin="0,12,0,2"/>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="18"
                                 Value="{Binding SelectedEnergy, Mode=OneWay}"/>
                        </StackPanel>

                <!-- Prisoner actions -->
                        <WrapPanel Grid.Row="1"
                                   Margin="0,15,0,10">

                            <Button Content="Crazy Action"
                                    Command="{Binding CrazyActionCommand}"
                                    Padding="10,6"
                                    Margin="0,0,6,6"/>

                            <Button Content="Work"
                                    Command="{Binding WorkCommand}"
                                    Padding="10,6"
                                    Margin="0,0,6,6"/>

                            <Button Content="Study"
                                    Command="{Binding StudyCommand}"
                                    Padding="10,6"
                                    Margin="0,0,6,6"/>

                            <Button Content="Play Chess"
                                    Command="{Binding ChessCommand}"
                                    Padding="10,6"
                                    Margin="0,0,6,6"/>

                            <Button Content="Remove"
                                    Command="{Binding RemoveCommand}"
                                    Padding="10,6"
                                    Margin="0,0,6,6"/>
                        </WrapPanel>

                        <TabControl Grid.Row="2">
                            <TabItem Header="Sorteeritud">
                                <ListBox ItemsSource="{Binding SortedPrisoners}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text=" - energia: "/>
                                        <Run Text="{Binding Energy, Mode=OneWay}"/>
                                                <Run Text="/100"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>

                            <TabItem Header="Tüüpide kokkuvõte">
                                <ListBox ItemsSource="{Binding Summary}"/>
                            </TabItem>

                            <TabItem Header="Action log">
                                <ListBox ItemsSource="{Binding Log}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="CPU arvutused">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock FontWeight="Bold"
                                       FontSize="15"
                                       Text="Vali vähemalt kolm vangi"/>

                            <TextBlock Margin="0,4,0,8"
                                       TextWrapping="Wrap"
                                       Text="Mõlemad režiimid kasutavad samu lähteandmete snapshot'e ja sama arvutuste arvu"/>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 Height="180"
                                 Margin="0,0,0,10"
                                 ItemsSource="{Binding ComputationPrisoners}"
                                 IsEnabled="{Binding CanEditComputations}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">     

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name, Mode=OneWay}"/>
                                            <TextBlock Text=" | "/>
                                            <TextBlock Text="{Binding Type, Mode=OneWay}"/>
                                            <TextBlock Text=" | energia: "/>
                                            <TextBlock Text="{Binding Energy, Mode=OneWay}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2"
                                    Margin="0,0,0,10">

                            <TextBlock Text="Arvutuste arv ühe vangi kohta"
                                       Margin="0,0,0,4"/>

                            <ComboBox Grid.Row="2"
                                      ItemsSource="{Binding WorkloadOptions}"
                                      SelectedItem="{Binding SelectedWorkload, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEditComputations}"
                                      IsEditable="False"
                                      IsReadOnly="True"
                                      MaxDropDownHeight="300"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="Järjestikune"
                                        Command="{Binding RunSequentialCommand}"
                                        Padding="10,6"
                                        Margin="0,0,6,6"/>

                                <Button Content="Paralleelne"
                                        Command="{Binding RunParallelCommand}"
                                        Padding="10,6"
                                        Margin="0,0,6,6"/>
                                
                                <ComboBox ItemsSource="{Binding CancellationTargets}"
                                          SelectedItem="{Binding SelectedCancellationTarget, Mode=TwoWay}"
                                          IsEnabled="{Binding IsRunning}"
                                          IsEditable="False"
                                          MaxDropDownHeight="300"
                                          Width="200"
                                          Margin="0,0,6,6"/>

                                <Button Content="Tühista"
                                        Command="{Binding CancelCommand}"
                                        IsEnabled="{Binding IsRunning}"
                                        Padding="10,6"
                                        Margin="0,0,6,6"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding ComputationStatus}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,5"/>
                        </StackPanel>

                        <GroupBox Grid.Row="3"
                                  Header="Arvutuste aruanne">
                            <ListBox ItemsSource="{Binding ComputationReport}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</Window>
